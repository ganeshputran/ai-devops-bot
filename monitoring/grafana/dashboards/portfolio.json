{
  "title": "Portfolio Health Dashboard",
  "uid": "portfolio-health",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Page Status (1=UP, 0=DOWN)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "targets": [{
        "expr": "portfolio_page_up",
        "legendFormat": "{{page_name}}"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "DOWN"},"1": {"text": "UP"}}, "type": "value"}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Page uptime over time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "targets": [{
        "expr": "portfolio_page_up",
        "legendFormat": "{{page_name}}"
      }]
    },
    {
      "id": 3,
      "title": "Total checks run",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "expr": "sum(portfolio_check_total)",
        "legendFormat": "Total checks"
      }]
    },
    {
      "id": 4,
      "title": "Pages currently down",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 12},
      "targets": [{
        "expr": "count(portfolio_page_up == 0)",
        "legendFormat": "Pages down"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
